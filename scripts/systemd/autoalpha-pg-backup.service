[Unit]
Description=AutoAlpha PostgreSQL database backup
After=postgresql.service
Requires=postgresql.service
OnFailure=autoalpha-pg-backup-alert.service

[Service]
Type=oneshot
User=qusong
Group=qusong
Environment=HOME=/home/qusong
Environment=QM_RUNTIME_ENV_FILE=/home/qusong/.config/autoalpha/runtime.env
Environment=AUTOALPHA_BACKUP_DIR=/mnt/e/AutoAlphaBackups
ReadWritePaths=/mnt/e/AutoAlphaBackups
WorkingDirectory=/mnt/d/git/autoalpha
ExecStart=/usr/bin/bash /mnt/d/git/autoalpha/scripts/wsl/pg-backup.sh
Nice=10
IOSchedulingClass=best-effort
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true
