[Unit]
Description=Record AutoAlpha health probe failure in the system journal
StartLimitIntervalSec=3600
StartLimitBurst=1

[Service]
Type=oneshot
ExecStart=/usr/bin/logger -p daemon.crit -t autoalpha-health "Backend /health probe failed; inspect autoalpha-healthcheck.service and autoalpha-backend.service"
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
