[Unit]
Description=Check free space on the Windows volume backing the AutoAlpha WSL distro
OnFailure=autoalpha-disk-alert.service

[Service]
Type=oneshot
User=qusong
Group=qusong
Environment=AUTOALPHA_HOST_MOUNT=/mnt/c
Environment=AUTOALPHA_MIN_HOST_FREE_GIB=20
ExecStart=/usr/bin/bash /mnt/d/git/autoalpha/scripts/wsl/disk-space-check.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/mnt/c
