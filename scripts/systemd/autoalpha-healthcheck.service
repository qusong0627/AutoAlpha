[Unit]
Description=Check AutoAlpha backend health endpoint
After=autoalpha-backend.service
OnFailure=autoalpha-health-alert.service

[Service]
Type=oneshot
User=qusong
Group=qusong
Environment=HEALTH_URL=http://127.0.0.1:6789/health
ExecStart=/usr/bin/bash /mnt/d/git/autoalpha/scripts/wsl/healthcheck.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
