# 密钥文件模板。**推荐放到 ext4，而不是仓库内**：
#   bash scripts/wsl/init-runtime-env.sh
# If ~/.config/autoalpha/runtime.env exists but is missing credentials:
#   bash scripts/wsl/init-runtime-env.sh --complete
# Manual alternative (run from the repository root inside WSL):
#   mkdir -p -m 700 ~/.config/autoalpha
#   cp config/runtime.env.example ~/.config/autoalpha/runtime.env
#   chmod 600 ~/.config/autoalpha/runtime.env
#
# 为什么不放仓库里：仓库位于 D:（drvfs），chmod 不生效——文件一律显示 0777，
# 即同机所有用户可读；只有 ext4 上的 $HOME 才能真正 0600。
#
# start-dev.sh 的查找顺序：显式 ENV_FILE > ~/.config/autoalpha/runtime.env > config/runtime.env；
# 它还会 export QM_RUNTIME_ENV_FILE，使 backend/shared/runtime_secrets.py 读同一个文件。
#
# 该文件**含密钥**：不要提交、不要外传、不要贴进聊天/issue。
# 生成随机密钥：
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── 必填：缺失则 start-dev.sh 拒绝启动（fail-closed）────────────────
# 服务间内部信任密钥。必须随机；**不得**是 auth.py::_PUBLIC_INTERNAL_DEFAULTS 里的值
# （那里的值一律视为未配置）。注意：被列入该集合 = 失效，不是安全。
INTERNAL_CALL_SECRET=
# LLM Key：从下面的服务端变量中至少配置一个（DeepSeek / AI_IDE / OpenAI）。
# 旧 DeepSeek Key 曾泄漏；若继续使用 DeepSeek，必须先吊销旧 Key 后再换新。
# 注意保持**注释状态**直到你填好真实值：本文件是被 `set -a; . file` 加载的，
# 空的 `KEY=` 会覆盖掉同名外部 export 值。
# DEEPSEEK_API_KEY=
# AI_IDE_LLM_API_KEY=
# AI_IDE_API_KEY=

# ── LLM / Embedding provider configuration (server-side only) ─────────
# Mining ignores any API keys stored in user Profile data. Set provider keys here
# or export them in the service environment; never use VITE_* for credentials.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=
# EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# Optional factor naming provider (only used when remote naming is enabled).
# QMF_FACTOR_NAME_API_KEY=

# Optional data/provider credentials. Configure only integrations you use.
# These are read from the server environment; do not put them in a user Profile.
# QUANTDB_API_KEY=
# TUSHARE_TOKEN=
# MODELSCOPE_TOKEN=                 # alias: MODELSCOPE_API_TOKEN
# IFIND_REFRESH_TOKEN=
# AKSHARE_API_KEY=
# TONGYI_QIANWEN_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# TSANGHI_API_KEY=
# QWEN_API_KEY=
# GEMINI_API_KEY=
# CLAUDE_API_KEY=
# BAIDU_API_KEY=
# ZHIPU_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# JUHE_API_KEY=
# CANGHAI_API_KEY=
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_BUCKET=
# TENCENT_REGION=ap-guangzhou

# Optional QQ Bot notification credentials (default channel).
# QQ_BOT_APP_ID=
# QQ_BOT_APP_SECRET=
# QQ_BOT_OWNER_OPENID=
# Optional market-specific channels use the same three suffixes: QQ_BOT_HK_* / QQ_BOT_US_*.

# Optional document parser credentials (used only when ENABLE_DOC_MINING=true).
# MINERU_MODE=cloud
# MINERU_API_TOKEN=
# MINERU_BASE_URL=
# MINERU_MODEL_VERSION=
# Or configure a private/local parser:
# MINERU_MODE=local
# MINERU_LOCAL_URL=
# MINERU_LOCAL_API_KEY=
# MINERU_LOCAL_TIER=standard

# PostgreSQL 密码：当 DATABASE_URL 未设置时，start-dev.sh 用它构造连接串。
# 可在此填写，或直接在受保护的 WSL 环境中 export DB_PASSWORD。
# DB_PASSWORD=

# Required before enabling the nightly PostgreSQL backup timer. Must be a private
# POSIX directory on a filesystem different from PostgreSQL's data filesystem.
# AUTOALPHA_BACKUP_DIR=
# AUTOALPHA_BACKUP_RETENTION_DAYS=14

# ── 建议填写 ────────────────────────────────────────────────────────
# 用户 JWT 签名密钥。不填则每次重启随机生成 → 所有已签发令牌立即失效。
SECRET_KEY=
# LLM 端点（可选覆盖）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# ── P0-4 护栏（可选；留空/注释掉则用代码内默认值）───────────────────
# qlib joblib worker 上限（默认/最大 4）。qlib 默认按可用 CPU 数起 worker，
# 不钉住的话一次重计算会派生二十多个进程；超过 4 会被代码上限截断。
# QLIB_KERNELS=4
# promote* 重计算的硬超时（秒，默认 180，最大 1800；非有限数回落默认值）
# FACTOR_PROMOTE_TIMEOUT_SECONDS=180
# promote* 重计算并发（默认 2，最大 4）
# FACTOR_PROMOTE_MAX_CONCURRENCY=2

# ── 免登录开关（**仅限本机**；对外暴露前务必置 0）────────────────────
# AUTH_DISABLED=1
# 活跃挖掘任务租约秒数（120–3600，默认 180）；服务周期续期，过期后回收。
# ALPHA_TASK_LEASE_SECONDS=180
